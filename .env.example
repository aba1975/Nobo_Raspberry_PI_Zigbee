# Nobo Eco Hub Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Your Nobo Eco Hub serial number (12 digits, found on the back of the hub)
NOBO_SERIAL=123456789012

# Your Nobo Eco Hub IP address (check your router's device list)
NOBO_IP=192.168.1.100

# Set to "true" to run in demo mode without a real hub (for testing).
# "1" and "yes" also count as true. Note that a serial of 111111111111 turns
# demo mode on by itself, whatever this is set to.
NOBO_DEMO=false

# Leave this alone unless you know you need it.
# By default every /api/... address and the live-update connection require you
# to be logged in. Setting this to "true" removes that requirement so scripts
# and other systems (for example Home Assistant) can read and control your
# heating without a password. Anyone on your network could then do the same,
# so only turn it on if you trust every device on that network.
NOBO_ALLOW_ANON_API=false

# Which interface you get at the usual address.
#
#   cabin    the current interface (default)
#   classic  the original one
#
# Both are installed in every build, and both are always reachable at /cabin
# and /classic no matter what this says - so you can compare them without
# changing anything. This setting only decides which one answers "/".
#
# To go back to the old interface:
#   1. set NOBO_UI=classic here
#   2. sudo systemctl restart nobo-control
# That takes a few seconds, needs no rebuild and no internet, and keeps every
# other fix the server has had since. An unrecognised value here is ignored
# with a warning rather than stopping the server.
NOBO_UI=cabin

# ---------------------------------------------------------------------------
# HTTPS (optional)
# ---------------------------------------------------------------------------
# Everything below is only read when you start the TLS proxy:
#
#   docker compose --profile tls up -d
#
# Leave it all alone and nothing changes: the app answers plain HTTP on
# port 8000, as it always has.
#
# See "HTTPS on Your Own Network" in the README for the full walkthrough.

# Where the app listens. Set this to 127.0.0.1 when you turn HTTPS on, so the
# unencrypted port stops answering the network and Caddy is the only way in.
NOBO_BIND=0.0.0.0
NOBO_PORT=8000

# Turning HTTPS on properly.
#
# Uncomment this and the proxy becomes part of the normal stack, rather than
# something you have to remember to add to every command. It is what makes
# "docker compose up", scripts/update.sh and the systemd service all start
# Caddy too — without it the service starts the application alone, and with
# NOBO_BIND=127.0.0.1 that leaves nothing answering the network after a reboot.
#
# Equivalent to passing --profile tls by hand every time, and harder to forget.
#COMPOSE_PROFILES=tls

# The name you want to type in the browser. Point it at the Pi's LAN address in
# your router's local DNS, so it resolves inside the house.
#
# Any name works with the default (Caddy's own CA), including something like
# nobo.home.arpa that you have not registered anywhere. If you switch to the
# Let's Encrypt option below it must be a real name in a domain you own.
NOBO_DOMAIN=nobo.example.com

# ---------------------------------------------------------------------------
# Only needed for the Let's Encrypt option
# ---------------------------------------------------------------------------
# The default issues the certificate from Caddy's own CA: nothing to register,
# no DNS records, and you install its root certificate once per device.
#
# To use a publicly-trusted certificate instead, uncomment all four settings
# below and follow "Option B" in the README. Note that the first build then
# compiles Caddy from source, which takes several minutes on a Pi.
#
#NOBO_CADDYFILE=./tls/Caddyfile.acme
#CADDY_BINARY_SOURCE=caddy-plugins
#CADDY_DNS_PLUGIN=github.com/caddy-dns/acmedns
#NOBO_TLS_EMAIL=you@example.com

# Credentials from "curl -X POST https://auth.acme-dns.io/register".
# ACMEDNS_SUBDOMAIN is the "subdomain" field of that response, not your own
# hostname. Treat the password like any other secret: .env is gitignored.
#ACMEDNS_USERNAME=
#ACMEDNS_PASSWORD=
#ACMEDNS_SUBDOMAIN=
#ACMEDNS_SERVER_URL=https://auth.acme-dns.io
