# Nobo Eco Hub Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Your Nobo Eco Hub serial number (12 digits, found on the back of the hub)
NOBO_SERIAL=123456789012

# Your Nobo Eco Hub IP address (check your router's device list)
NOBO_IP=192.168.1.100

# Set to "true" to run in demo mode without a real hub (for testing).
# "1" and "yes" also count as true. Note that a serial of 111111111111 turns
# demo mode on by itself, whatever this is set to.
NOBO_DEMO=false

# Leave this alone unless you know you need it.
# By default every /api/... address and the live-update connection require you
# to be logged in. Setting this to "true" removes that requirement so scripts
# and other systems (for example Home Assistant) can read and control your
# heating without a password. Anyone on your network could then do the same,
# so only turn it on if you trust every device on that network.
NOBO_ALLOW_ANON_API=false
