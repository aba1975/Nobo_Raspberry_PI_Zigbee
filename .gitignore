# Credentials for a DNS provider, if HTTPS is set up the Let's Encrypt way.
.acmedns.json
*.acmedns.json

# Exported by the README's HTTPS instructions, into the install directory.
# Not a secret — it is a public certificate — but it belongs to one machine
# and should never be committed.
nobo-root.crt

# User data (runtime state, created by the app)
data/

# Docker
docker-compose.override.yml

# Scratch space for ad-hoc deployment and debugging scripts. Kept out of the
# repository because these tend to carry host addresses and passwords typed in
# for one session, which is exactly the sort of thing that gets committed by
# accident.
.pi/

# Nobo's own documents. Useful to have locally while working on the protocol,
# but they are Glen Dimplex Nordic's copyright and are not ours to redistribute.
# See "Reference documents" in the README for where to get them.
API_Nobo.pdf
Manual_Nobo.pdf
*.pdf
